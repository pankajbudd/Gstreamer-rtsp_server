export GST_ROOT=/opt/gstreamer
export PATH=$GST_ROOT/bin:$PATH
export LD_LIBRARY_PATH=$GST_ROOT/lib/x86_64-linux-gnu:$GST_ROOT/lib:$LD_LIBRARY_PATH
export GST_PLUGIN_SYSTEM_PATH=$GST_ROOT/lib/x86_64-linux-gnu/gstreamer-1.0
export GST_PLUGIN_PATH=$GST_ROOT/lib/x86_64-linux-gnu/gstreamer-1.0
export PKG_CONFIG_PATH=/opt/gstreamer/lib/x86_64-linux-gnu/pkgconfig:$PKG_CONFIG_PATH
